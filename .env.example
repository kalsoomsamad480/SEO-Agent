# Copy this file to ".env" and fill in your own values.
# NEVER commit .env. It holds secrets. (.gitignore already ignores it.)

# ---------- LLM (required from Phase 2) ----------
# We talk to any "OpenAI-compatible" chat API, so switching provider only
# means changing these three lines. Providers with a free tier:
#   Google Gemini : LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                   LLM_MODEL=gemini-flash-latest    (key: https://aistudio.google.com/apikey)
#   Groq          : LLM_BASE_URL=https://api.groq.com/openai/v1
#                   LLM_MODEL=llama-3.3-70b-versatile (key: https://console.groq.com/keys)
#   OpenRouter    : LLM_BASE_URL=https://openrouter.ai/api/v1  (some ":free" models)
# Paid, same 3 lines: OpenAI (https://api.openai.com/v1), Anthropic Claude (https://api.anthropic.com/v1)
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
# Optional backup model, used only when the main model is overloaded (HTTP 503/429).
LLM_FALLBACK_MODEL=gemini-flash-latest

# Seconds to wait for one LLM reply before giving up.
LLM_TIMEOUT_SECONDS=120

# ---------- Your website (Phase 5, optional) ----------
# Used to build page URLs for internal links, e.g. https://myblog.com
SITE_URL=

# ---------- Google PageSpeed Insights (Phase 6, optional) ----------
# Works without a key at low volume; a free key raises the limit.
# Get one at https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ---------- Brave Search (Phase 7, optional) ----------
# Finds backlink opportunities through an official search API (no scraping).
# Key: https://brave.com/search/api/  (check their current free plan)
BRAVE_SEARCH_API_KEY=

# ---------- WordPress (optional, drafts only) ----------
# Test with: python main.py wordpress --check
# Use an "Application Password" (WP Admin -> Users -> Profile), NOT your login password.
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# ---------- General ----------
# DEBUG shows more detail in the console; INFO is normal.
LOG_LEVEL=INFO
